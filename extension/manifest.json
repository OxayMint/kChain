{
  "manifest_version": 3,
  "name": "kChain",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Fill, save, and import Chrome passwords on the kChain device.",
  "key": "",
  "action": {
    "default_title": "kChain",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs", "windows", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:4318/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
